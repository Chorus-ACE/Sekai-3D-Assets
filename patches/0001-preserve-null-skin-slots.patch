+    private static ExactBoneReferences CompactUnusedNullSkinSlots(
+        ImportedMesh mesh, IReadOnlyList<string> paths, IReadOnlyList<long> pathIds)
+    {
+        if (!pathIds.Contains(0)) return new ExactBoneReferences(paths, pathIds);
+        if (paths.Count != pathIds.Count || mesh.BoneList?.Count != pathIds.Count)
+            throw new InvalidDataException($"Mesh '{mesh.Path}' has null slots without a matching bindpose palette.");
+        var retained = Enumerable.Range(0, pathIds.Count).Where(i => pathIds[i] != 0).ToArray();
+        if (retained.Length == 0)
+            throw new InvalidDataException($"Mesh '{mesh.Path}' has no resolved skin bones.");
+        var remap = Enumerable.Repeat(-1, pathIds.Count).ToArray();
+        for (var i = 0; i < retained.Length; i++) remap[retained[i]] = i;
+        // Validate the entire mesh before mutation. Never guess a weighted null bone.
+        foreach (var vertex in mesh.VertexList)
+        {
+            if (vertex.BoneIndices is not { Length: 4 } || vertex.Weights is not { Length: 4 })
+                throw new InvalidDataException("Null-slot skin data must contain four influences.");
+            for (var i = 0; i < 4; i++)
+            {
+                var weight = vertex.Weights[i]; var index = vertex.BoneIndices[i];
+                if (!float.IsFinite(weight) || weight < 0 ||
+                    (weight > 0 && (index < 0 || index >= remap.Length || remap[index] < 0)))
+                    throw new InvalidDataException($"Mesh '{mesh.Path}' has an invalid or unresolved weighted skin slot {index}.");
+            }
+        }
+        foreach (var vertex in mesh.VertexList)
+            for (var i = 0; i < 4; i++)
+                vertex.BoneIndices[i] = vertex.Weights[i] == 0 ? 0 : remap[vertex.BoneIndices[i]];
+        mesh.BoneList = retained.Select(i => mesh.BoneList![i]).ToList();
+        return new ExactBoneReferences(retained.Select(i => paths[i]).ToArray(), retained.Select(i => pathIds[i]).ToArray());
