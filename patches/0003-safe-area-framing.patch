+import assert from 'node:assert/strict';
+import test from 'node:test';
+import * as THREE from 'three';
+import { Haruki3DEngineCore } from '../dist/haruki-3d-engine-internal.js';
+
+function fixture(width, height) {
+  const engine = Object.create(Haruki3DEngineCore.prototype);
+  engine.camera = new THREE.PerspectiveCamera(35, width / height, 0.1, 100);
+  engine.camera.position.set(0, 1, 4.5);
+  engine.camera.lookAt(0, 1, 0);
+  engine.camera.updateMatrixWorld();
+  engine.viewportInsets = [0, 0, 0, 0];
+  engine.viewportWidth = width;
+  engine.viewportHeight = height;
+  engine.viewportPixelRatio = 0;
+  engine.ownsCanvas = false;
+  engine.renderer = { setPixelRatio() {}, setSize() {} };
+  engine.updateCaptureBackgroundTexture = () => {};
+  return engine;
+}
+function pixel(point, camera, width, height) {
+  const p = point.clone().project(camera);
+  return [(p.x + 1) * width / 2, (1 - p.y) * height / 2];
+}
+function close(a, b) { assert.ok(Math.abs(a - b) < 1e-7, `${a} != ${b}`); }
+function compareSafeFrame(engine, width, height, [top, right, bottom, left]) {
+  const safeWidth = width - left - right, safeHeight = height - top - bottom;
+  const reference = engine.camera.clone();
+  reference.clearViewOffset(); reference.aspect = safeWidth / safeHeight; reference.updateProjectionMatrix();
+  for (const world of [new THREE.Vector3(0, 1, 0), new THREE.Vector3(-.4, 1.7, .2), new THREE.Vector3(.4, .1, -.1)]) {
+    const safe = pixel(world, reference, safeWidth, safeHeight);
+    const full = pixel(world, engine.camera, width, height);
+    close(full[0], left + safe[0]); close(full[1], top + safe[1]);
+  }
+  return reference;
+}
+test('portrait, landscape and asymmetric panes retain the safe-area framing', () => {
+  for (const [w, h, insets] of [[402, 874, [164, 0, 83, 0]], [874, 402, [44, 59, 21, 59]], [1024, 768, [50, 320, 20, 0]], [700, 800, [0, 0, 0, 0]]]) {
+    const engine = fixture(w, h), position = engine.camera.position.clone();
+    engine.setViewportInsets(...insets);
+    compareSafeFrame(engine, w, h, insets);
+    assert.ok(position.equals(engine.camera.position));
+  }
+});
+test('the expanded frustum allows a model to move beyond the safe rectangle', () => {
+  const engine = fixture(402, 874), insets = [164, 0, 83, 0];
+  engine.setViewportInsets(...insets);
+  const reference = compareSafeFrame(engine, 402, 874, insets);
+  const world = new THREE.Vector3(0, 1.15, .5).unproject(reference);
+  const full = pixel(world, engine.camera, 402, 874);
+  assert.ok(full[1] > 0 && full[1] < insets[0]);
+});
+test('resize and camera changes preserve the safe center without resetting zoom or pan', () => {
+  const engine = fixture(402, 874);
+  engine.setViewportInsets(164, 0, 83, 0);
+  engine.camera.position.set(.5, 1.2, 2.3); engine.camera.lookAt(0, 1.2, 0); engine.camera.updateMatrixWorld();
+  globalThis.window = { devicePixelRatio: 2 };
+  engine.setViewportSize(874, 402);
+  engine.setViewportInsets(44, 59, 21, 59);
+  compareSafeFrame(engine, 874, 402, [44, 59, 21, 59]);
+  assert.deepEqual(engine.camera.position.toArray(), [.5, 1.2, 2.3]);
+});
+test('invalid or temporarily oversized insets cannot produce an invalid camera', () => {
+  const engine = fixture(20, 10);
+  engine.setViewportInsets(Infinity, -20, NaN, 0);
+  compareSafeFrame(engine, 20, 10, [0, 0, 0, 0]);
+  engine.setViewportInsets(900, 800, 700, 600);
+  assert.ok(engine.camera.projectionMatrix.elements.every(Number.isFinite));
+});
