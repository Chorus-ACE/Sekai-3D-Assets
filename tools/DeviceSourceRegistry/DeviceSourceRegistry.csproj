<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HarukiRoot Condition="'$(HarukiRoot)' == ''">../../.vendor/Haruki-3D</HarukiRoot>
  </PropertyGroup>
  <!-- Only Haruki's master-data resolver. No AssetStudio, native exporter or NuGet dependencies. -->
  <ItemGroup>
    <Compile Include="$(HarukiRoot)/exporter/Models/CostumeRegistryModels.cs" Link="Haruki/CostumeRegistryModels.cs" />
    <Compile Include="$(HarukiRoot)/exporter/Models/MasterCostumeModels.cs" Link="Haruki/MasterCostumeModels.cs" />
    <Compile Include="$(HarukiRoot)/exporter/Services/CostumeRegistryExporter.cs" Link="Haruki/CostumeRegistryExporter.cs" />
    <Compile Include="$(HarukiRoot)/exporter/Services/MasterDataReader.cs" Link="Haruki/MasterDataReader.cs" />
    <Compile Include="$(HarukiRoot)/exporter/Services/RuntimeJsonWriter.cs" Link="Haruki/RuntimeJsonWriter.cs" />
    <Compile Include="$(HarukiRoot)/exporter/Services/RuntimeRoleCatalogExporter.cs" Link="Haruki/RuntimeRoleCatalogExporter.cs" />
    <Compile Include="$(HarukiRoot)/exporter/Services/CharacterHeightResolver.cs" Link="Haruki/CharacterHeightResolver.cs" />
  </ItemGroup>
</Project>
